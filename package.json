{
  "name": "my-ai-notes",
  "displayName": "My ai notes",
  "version": "0.0.1",
  "description": "A basic Plasmo extension.",
  "author": "Hashmat Shaik",
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "permissions": [
      "sidePanel",
      "scripting",
      "activeTab",
      "storage",
      "unlimitedStorage",
      "tabs"
    ]
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "katex": "^0.19.1",
    "marked": "^12.0.2",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/katex": "^0.16.8",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/turndown": "^5.0.4",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  }
}
